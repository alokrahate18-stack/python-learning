{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "🐍 Run Python File",

            "type": "shell",

            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",

            "args": [
                "-X",
                "utf8",
                "-u",
                "${file}"
            ],

            "group": {
                "kind": "test",
                "isDefault": true
            },

            "problemMatcher": [],

            "detail": "Run current Python file using project virtual environment",

            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            },

            "options": {
                "cwd": "${workspaceFolder}",

                "env": {
                    "PYTHONUTF8": "1"
                }
            }
        },

        {
            "label": "🐍 Run Python Project",

            "type": "shell",

            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",

            "args": [
                "-X",
                "utf8",
                "-u",
                "${workspaceFolder}\\src\\main.py"
            ],

            "group": "test",

            "problemMatcher": [],

            "detail": "Run project entry point",

            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },

            "options": {
                "cwd": "${workspaceFolder}",

                "env": {
                    "PYTHONUTF8": "1"
                }
            }
        }
    ]
}
